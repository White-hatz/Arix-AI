# Optional fallback. The preferred method is the in-app Settings field.
GEMINI_API_KEY=your_gemini_api_key_here
ARIX_HOST=127.0.0.1
ARIX_PORT=8765
ARIX_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Firebase RTDB graph memory. If omitted, Arix uses backend/data/memory_graph.json.
ARIX_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
ARIX_FIREBASE_SERVICE_ACCOUNT=C:\\path\\to\\firebase-service-account.json
# Alternative for managed environments (single-line JSON):
ARIX_FIREBASE_SERVICE_ACCOUNT_JSON={"apiKey": "your_api_key", "projectId": "your_project_id", "databaseURL": "https://your-project-default-rtdb.firebaseio.com"}
